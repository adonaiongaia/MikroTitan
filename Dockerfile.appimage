# syntax=docker/dockerfile:1.7
#
# Build the release AppImage on Ubuntu 22.04 (glibc 2.35), the oldest baseline
# AppImageHub still tests. An AppImage does not bundle glibc, so the build host
# fixes its minimum glibc requirement.
#
# The final image only contains the finished AppImage; use
# scripts/build-appimage-docker.sh to build it and copy the artifact out.

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Same runtime/build dependency set as .github/workflows/appimage.yml.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        gnupg \
        pkg-config \
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        librsvg2-dev \
        patchelf \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-alsa \
        gstreamer1.0-pipewire \
    && rm -rf /var/lib/apt/lists/*

# Node is only used to build the frontend and is not shipped in the AppImage.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Use the same stable Rust channel as CI.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY . .

# Keep the Cargo target directory in a BuildKit cache so source changes reuse
# compiled dependencies. The AppImage is copied to /artifacts inside this RUN
# because the cache mount itself is not part of the image layer.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/src-tauri/target \
    npm run appimage \
    && mkdir -p /artifacts \
    && cp src-tauri/target/release/bundle/appimage/*.AppImage /artifacts/

FROM ubuntu:22.04 AS artifact

COPY --from=builder /artifacts /artifacts

LABEL org.opencontainers.image.title="MikroTitan AppImage artifact"
LABEL org.opencontainers.image.description="Finished MikroTitan AppImage built on Ubuntu 22.04 (glibc 2.35)"
